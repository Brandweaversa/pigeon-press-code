# ── Pigeon Press environment template ─────────────────────────────
# Copy these into Vercel → Settings → Environment Variables
# (and into a local .env file if you run the app on your own PC)

# Your cPanel MySQL database.
# Replace 4 things: USER, PASSWORD, HOST, DBNAME — the guide shows where to find each.
# While running ON YOUR PC before deploy, HOST is usually your domain (pigeoncomms.co.za);
# while on Vercel it is the same value. Get it from cPanel → MySQL Databases.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# A long random secret used to sign login sessions.
# Generate one at https://passwordsgenerator.net (tick "Exclude ambiguous characters"),
# copy at least 32 characters.
NEXTAUTH_SECRET="paste-a-long-random-secret-here"

# The public address of the app (no trailing slash).
NEXTAUTH_URL="https://pac.pigeoncomms.co.za"
