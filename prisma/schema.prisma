// Pigeon Press — magazine platform schema
// MySQL (production on cPanel). No enums / Json / native types are used on
// purpose so the provider can be switched to "sqlite" for local dev without
// changing a single line.
//
// Moderation model: only PUBLISHERS are approved/rejected. Content from an
// approved publisher is live immediately — magazines and editions carry no
// status of their own; visibility always derives from publisher.status.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("PIGEON_DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("READER") // READER | PUBLISHER | ADMIN
  createdAt    DateTime      @default(now())

  publisher     Publisher?
  favourites    Favourite[]
  notifications Notification[]
}

model Publisher {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  contactEmail    String
  about           String?    @db.Text
  logoImageId     String?
  status          String     @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason String?    @db.Text
  createdAt       DateTime   @default(now())

  magazines Magazine[]
}

model Magazine {
  id          String     @id @default(cuid())
  publisherId String
  publisher   Publisher  @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  name        String
  description String?    @db.Text
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  logoImageId String
  frequency   String? // Weekly / Monthly / Quarterly ...
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  editions   Edition[]
  favourites Favourite[]
}

model Edition {
  id               String   @id @default(cuid())
  magazineId       String
  magazine         Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  title            String
  issueNumber      String?
  flipbookUrl      String     @db.Text
  thumbnailImageId String
  sortOrder        Int      @default(0) // display order to readers, managed by the publisher
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([magazineId, sortOrder])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  sortOrder Int        @default(0)
  magazines Magazine[]
}

model Favourite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  magazineId String
  magazine   Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  notify     Boolean  @default(true) // receive notifications on new editions
  createdAt  DateTime @default(now())

  @@unique([userId, magazineId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Image {
  id        String   @id @default(cuid())
  kind      String // cover | logo | background | icon | edition
  mime      String
  size      Int
  width     Int?
  height    Int?
  data      Bytes
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Page {
  slug      String   @id // terms | privacy
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}
